//     writable: true
// });

// user.age = 22;

// console.log(user.age);
// console.log(Object.keys(user));
// console.log(Object.hasOwn(user, "age"));
// ```

// Output:

// ```text
// 22
// ["name"]
// true
// ```

// Important:

// ```text
// age exists ✅
// age accessible ✅
// age writable ✅
// age enumerable ❌
// ```

